ESS.FIELDS.ite{{! Items Tab }}
<section class="tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="items">
  {{#if canAdd}}
  <a class="item-control item-create" data-action="addItem">
    <i class="fa fa-plus"></i>{{localize "Boundless.Sheets.Labels.AddItem"}}
  </a>
  {{else}}
  <a class="item-control item-create" disabled>
    <i class="fa fa-plus"></i>{{localize "Boundless.Sheets.Labels.AddItem"}}
  </a>
  {{/if}}
  <ul class="items">
    {{#each items as |item|}}
    <li class="item flexrow draggable" data-item-id="{{item._id}}" data-document-class="Item">
      <img src="{{item.img}}" alt="<b>{{item.name}}</b>" width="24" height="24">

      {{#if (eq item.type "armor")}}
        <div class="item-name"><b>{{item.name}}</b> / {{item.system.slots}} {{localize 'Boundless.Item.FIELDS.slots.label'}} / {{localize 'Boundless.Item.FIELDS.armor.label'}} {{item.system.armor}} / {{localize 'Boundless.Item.FIELDS.uses.label'}} {{item.system.uses}} / {{localize 'Boundless.Item.FIELDS.remainingUses.label'}} {{item.system.remainingUses}}</div>
      {{/if}}
      {{#if (eq item.type "weapon")}}
        <div class="item-name"><b>{{item.name}}</b> / {{item.system.slots}} {{localize 'Boundless.Item.FIELDS.slots.label'}} / {{localize 'Boundless.Item.FIELDS.damage.label'}} {{item.system.damage}} / {{localize 'Boundless.Item.FIELDS.damageBonus.label'}} {{item.system.damageBonus}} / {{localize 'Boundless.Item.FIELDS.uses.label'}} {{item.system.uses}} / {{localize 'Boundless.Item.FIELDS.remainingUses.label'}} {{item.system.remainingUses}}</div>
      {{/if}}
      {{#if (eq item.type "basic")}}
        <div class="item-name"><b>{{item.name}}</b> / {{item.system.slots}} {{localize 'Boundless.Item.FIELDS.slots.label'}} / {{localize 'Boundless.Item.FIELDS.uses.label'}} {{item.system.uses}} / {{localize 'Boundless.Item.FIELDS.remainingUses.label'}} {{item.system.remainingUses}}</div>
      {{/if}}
      {{#if (eq item.type "spell")}}
        <div class="item-name"><b>{{item.name}}</b> / {{item.system.slots}} {{localize 'Boundless.Item.FIELDS.slots.label'}} / {{localize 'Boundless.Item.FIELDS.type.label'}}: {{item.system.type}}</div>
      {{/if}}
      {{#if (eq item.type "condition")}}
        <div class="item-name"><b>{{item.name}}</b> / {{item.system.slots}} {{localize 'Boundless.Item.FIELDS.slots.label'}} / {{localize 'Boundless.Item.FIELDS.type.label'}}: {{item.system.type}}</div>
      {{/if}}

      <div class="document-controls">
        <a class="item-control item-edit"
          title="{{localize 'DOCUMENT.Update' type=item.name}}"
          data-action="viewDoc">
          <i class="fas fa-edit"></i>
        </a>
        {{#if @root.editable}}
        <a class="item-control item-delete"
          title="{{localize 'DOCUMENT.Delete' type=item.name}}"
          data-action="deleteDoc">
          <i class="fas fa-trash"></i>
        </a>
        {{/if}}
      </div>
    </li>
    {{/each}}
  </ul>
</section>