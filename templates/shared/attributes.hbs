<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  {{#each fields}}
  {{#if fieldset}}
  <fieldset class="{{className}}">
    <h4>{{localize legend}}</h4>
    {{#each fields}}
    {{formGroup field value=value localize=true}}
    {{/each}}
    {{#if canRoll}}
    <a class="item-control attribute-roll" data-action="rollDice" data-roll-label="{{label}}" data-roll-path="{{rollValuePath}}">
        <i class='fas fa-dice'></i>
    </a>
    {{/if}}
  </fieldset>
  {{else}}
  {{formGroup outer.field value=outer.value localize=true}}
  {{/if}}
  {{/each}}
  <div class="recovery">
    <h4>{{localize "Boundless.Recovery.label"}}</h4>
    <div class="form-group">
      <div class="recovery-roll"></div>
      <a class="item-control recovery-roll" data-action="rollDice" data-roll-label="shortrest" data-roll-path="{{rollValuePath}}">
        <i class='fas fa-circle'><label> {{localize "Boundless.Recovery.ShortRest"}}</label></i>
      </a>
      <a class="item-control recovery-roll" data-action="rollDice" data-roll-label="longrest" data-roll-path="{{rollValuePath}}">
        <i class='fas fa-circle'><label> {{localize "Boundless.Recovery.LongRest"}}</label></i>
      </a>
    </div>
  </div>
</section>