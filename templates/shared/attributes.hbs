<section class="standard-form tab scrollable {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  {{#each fields}}
  {{#if fieldset}}
  <fieldset class="{{className}}">
    <h4>{{localize legend}}</h4>
    {{#each fields}}
    {{formGroup field value=value localize=true}}
    {{/each}}
    {{#if canRoll}}
    <a class="item-control attribute-roll" data-action="rollDice" data-roll-label="{{label}}" data-roll-path="{{rollValuePath}}">
        <i class='fas fa-dice'></i>
    </a>
    {{/if}}
  </fieldset>
  {{else}}
  {{formGroup outer.field value=outer.value localize=true}}
  {{/if}}
  {{/each}}
    {{{recovery}}}
</section>